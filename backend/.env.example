# ============================================================
# ARMYVERSE Backend — Environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to version control.
# ============================================================

# --- Astra DB (DataStax) credentials ------------------------
# Leave ASTRA_DB_API_ENDPOINT and ASTRA_DB_APPLICATION_TOKEN empty
# to run against a safe in-memory repository (offline / testing).
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_NAMESPACE=
ASTRA_DB_KEYSPACE=

# --- JWT secrets (use long random strings) ------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret

# Token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# --- Application ---------------------------------------------
# Allowed CORS origin(s) for the frontend (comma-separated list allowed,
# no wildcard in production). Use the deployed frontend URL here,
# e.g. https://armyverse.onrender.com
FRONTEND_URL=http://localhost:5173

# Backend port (uvicorn --port $PORT)
PORT=8000

# --- Rate limiting (requests per minute per key) -------------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=3
RATE_LIMIT_REFRESH_PER_MIN=10
RATE_LIMIT_COMMENT_PER_MIN=20
RATE_LIMIT_CREATE_POST_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# --- Pagination ----------------------------------------------
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=50

# --- Spotify API (Client Credentials) -------------------------
# Register at https://developer.spotify.com/dashboard
# Leave empty to fall back to the built-in hardcoded BTS catalog.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- AI Provider (Google Gemini) --------------------------------
# Required for the ARMY AI chat feature.  Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_MAX_TOKENS=500

# --- AI Free / Premium tiers ----------------------------------
# Free users get fewer tokens and a lower request rate.
AI_FREE_MAX_TOKENS=300
AI_PREMIUM_MAX_TOKENS=1000
AI_FREE_RATE_LIMIT=5
AI_PREMIUM_RATE_LIMIT=20

# --- Cloudflare R2 (production media storage) -----------------
# When all five are set, media uploads go to R2 and are stored as
# permanent public URLs (survive Render restarts/redeploys).
# When empty, media falls back to local disk under backend/uploads/
# (development / tests only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL (https://pub-<hash>.r2.dev, trailing slash optional)
R2_PUBLIC_BASE_URL=
